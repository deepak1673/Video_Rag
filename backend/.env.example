APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-long-random-secret
# Required header X-Demo-Token on protected endpoints (?token= for media URLs).
# Leave empty ONLY for purely local use in development.
DEMO_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:5173
UPLOADS_ENABLED=true

DATABASE_URL=postgresql+psycopg://video_rag:change_me_locally@127.0.0.1:5433/video_rag
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180

# Answer generation: ollama (local, default) | groq (free tier, public demo) | openai_compat
# Only generation goes to the cloud; Whisper, OCR and embeddings stay local.
LLM_PROVIDER=ollama
# Blank = provider default (groq: https://api.groq.com/openai/v1, llama-3.3-70b-versatile)
LLM_BASE_URL=
LLM_MODEL=
# Secret: set only in the deployment environment, never commit.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CLIP ViT-B/32 weights loaded via sentence-transformers (image + text share one space)
CLIP_MODEL=sentence-transformers/clip-ViT-B-32
# Optional model cache location (Hugging Face): HF_HOME=E:/aiii/Video_Rag/data/models

DATA_DIR=data
MAX_UPLOAD_MB=500
MAX_VIDEO_DURATION_SECONDS=900
MAX_CONCURRENT_VIDEO_JOBS=1
FRAME_SAMPLE_INTERVAL_SECONDS=8
OCR_ENABLED=true
SCENE_DETECTION_ENABLED=true
RETRIEVAL_TOP_K=8
MIN_FREE_DISK_GB=5
RATE_LIMIT_PER_MINUTE=60
